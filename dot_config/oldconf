# Enable 256 color support
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*:RGB"

# Enable mouse support
set -g mouse on

# Enable clipboard
set -g set-clipboard on

# set new prefix
unbind C-b 
set -g prefix C-Space
bind C-Space send-prefix

# Reload config
unbind r
bind r source-file $HOME/.config/tmux/tmux.conf \; display-message "tmux config reloaded"


# --- Panes --- # 

# Vim-like pane switching: Alt+hjkl 
bind -n M-h select-pane -L
bind -n M-j select-pane -D
bind -n M-k select-pane -U
bind -n M-l select-pane -R

# Vim-like pane swapping: Alt+Shift+hjkl
bind -n M-H run "tmux swap-pane -s {left-of}"
bind -n M-J run "tmux swap-pane -s {down-of}"
bind -n M-K run "tmux swap-pane -s {up-of}"
bind -n M-L run "tmux swap-pane -s {right-of}"


# --- Windows --- # 

# Vim-like window switching: Prefix+hl
bind h previous-window
bind l next-window

# Vim-like window swapping: Prefix+Shift+hl
bind H swap-window -t -1\; select-window -t -1
bind L swap-window -t +1\; select-window -t +1

# Split windows (opens in same directory)
unbind %
bind \\ split-window -h -c "#{pane_current_path}"
unbind '"'
bind - split-window -v -c "#{pane_current_path}"

# Navigate windows with Shift+Arrow (no prefix required)
bind -n S-Left previous-window
bind -n S-Right next-window 

# Change from 0 based to 1 based because keyboard layout
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

# Alt+number to select window
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

# ------- # 

# Vim-like copy/paste
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
unbind -T copy-mode-vi MouseDragEnd1Pane
